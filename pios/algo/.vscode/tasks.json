{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pios-algo: check setup",
      "type": "shell",
      "command": "bash scripts/bootstrap.sh --check",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1 -Check" },
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "pios-algo: bootstrap",
      "type": "shell",
      "command": "bash scripts/bootstrap.sh",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1" },
      "problemMatcher": []
    },
    {
      "label": "pios-algo: bootstrap + upgrade",
      "type": "shell",
      "command": "bash scripts/bootstrap.sh --upgrade",
      "windows": { "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap.ps1 -Upgrade" },
      "problemMatcher": []
    }
  ]
}
